# Supabase is the sole durable story store for authenticated accounts.
# Run the supplied Supabase schema/migrations before deploying.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
PRESSURE_ROOM_SUPABASE_TABLE=pressure_room_projects
PRESSURE_ROOM_AUTH_ENABLED=true
PRESSURE_ROOM_SESSION_KEY=
PRESSURE_ROOM_PUBLIC_URL=http://localhost:3000

# Ephemeral SQLite cache per authenticated user. Optional directory override.
PRESSURE_ROOM_USER_CACHE_DIR=

# Trusted development only; never enable the anonymous SQLite API publicly.
PRESSURE_ROOM_ALLOW_LOCAL_API=false
PRESSURE_ROOM_ALLOWED_ORIGINS=
