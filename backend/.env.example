# Drive is optional for local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PRESSURE_ROOM_SESSION_KEY=
PRESSURE_ROOM_PUBLIC_URL=http://localhost:3000

# Optional per-user ephemeral cache root.
PRESSURE_ROOM_USER_CACHE_DIR=

# Google Picker (browser-visible API key; restrict it in Google Cloud).
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Optional legacy server SQLite API. Keep false on public deployments.
# Browser-local storage works without this flag.
PRESSURE_ROOM_ALLOW_LOCAL_API=false
# Additional exact browser origins for trusted local development, comma separated.
PRESSURE_ROOM_ALLOWED_ORIGINS=
