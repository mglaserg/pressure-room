# Optional: override the server-side FastAPI target used by the Next.js server-side API proxy.
# Do NOT use NEXT_PUBLIC_API_URL for normal deployment; browser requests stay same-origin.
PRESSURE_ROOM_API_URL=http://127.0.0.1:8000

# Optional: canonical public frontend origin used to start Google OAuth on one
# hostname. Production defaults to https://pressure-room.com.
PRESSURE_ROOM_CANONICAL_ORIGIN=https://pressure-room.com
